$(document).ready(function(){
$('#playButton').click(function () {
$('#slider-animation').carousel('cycle');
$('#carouselButtons button').removeClass("active");
$('#playButton').addClass("active");
});
$('#pauseButton').click(function () {
$('#slider-animation').carousel('pause');
$('#carouselButtons button').removeClass("active");
$('#pauseButton').addClass("active");
});
$('#MpauseButton').click(function (e) {
e.preventDefault();
$('#marq').trigger('pause');
//$('#marq').stop(); // Stop the marquee animation
$('#marqButtons button').removeClass("active"); // Remove active class from all buttons
$(this).addClass("active"); // Add active class to the clicked button
});
$('#MplayButton').click(function (e) {
e.preventDefault();
$('#marq').trigger('resume');
//$('#marq').stop();
$('#marqButtons button').removeClass("active");
$('#MpauseButton').addClass("active");
});
$('#M1playButton').click(function (e) {
e.preventDefault();
$('#marq1').trigger('resume');
$('#marq1Buttons button').removeClass("active");
$('#M1playButton').addClass("active");
});
$('#M1pauseButton').click(function (e) {
e.preventDefault();
$('#marq1').trigger('pause');
$('#marq1Buttons button').removeClass("active");
$('#M1pauseButton').addClass("active");
});
$('.customer-logos').slick({
slidesToShow: 5,
slidesToScroll: 1,
autoplay: false,
//autoplaySpeed: 1500,
arrows: true,
dots: false,
//pauseOnHover: false,
responsive: [{
breakpoint: 768,
settings: {
slidesToShow: 4
}
}, {
breakpoint: 520,
settings: {
slidesToShow: 3
}
}]
});
});
