{"id": "JB-HIN-HO-0001", "source_language": "hi", "target_language": "ho", "source_text": "सुप्रभात बच्चों, अपनी किताब खोलो।", "target_text": "Seta Johar honko, apana puthi olo.", "audio": "audio/ho/sent_1.wav", "speaker_id": "SPK_HO_JH01", "domain": "Classroom Instruction", "script": "Devanagari / Warang Chiti", "dialect": "Kolhan Ho", "source": "Kaggle Ho-Hindi FLN & Tribal Research Institute", "license": "CC-BY-4.0", "confidence": 0.96, "human_verified": true}
{"id": "JB-HIN-HO-0002", "source_language": "hi", "target_language": "ho", "source_text": "आज हम एक से दस तक गिनती सीखेंगे।", "target_text": "Tising abu miyod ate gel jaked lekha bu ituna.", "audio": "audio/ho/sent_2.wav", "speaker_id": "SPK_HO_JH01", "domain": "FLN Mathematics", "script": "Devanagari / Warang Chiti", "dialect": "Kolhan Ho", "source": "Kaggle Ho-Hindi FLN & Tribal Research Institute", "license": "CC-BY-4.0", "confidence": 0.96, "human_verified": true}
{"id": "JB-HIN-HO-0003", "source_language": "hi", "target_language": "ho", "source_text": "दो और तीन मिलकर पाँच होते हैं।", "target_text": "Bāriyā ar āpiyā mesate moyā hobaoa.", "audio": "audio/ho/sent_3.wav", "speaker_id": "SPK_HO_JH01", "domain": "FLN Mathematics", "script": "Devanagari / Warang Chiti", "dialect": "Kolhan Ho", "source": "Kaggle Ho-Hindi FLN & Tribal Research Institute", "license": "CC-BY-4.0", "confidence": 0.96, "human_verified": true}
{"id": "JB-HIN-HO-0004", "source_language": "hi", "target_language": "ho", "source_text": "हाथ धोकर खाना खाओ।", "target_text": "Ti arup' kete mandi jompe.", "audio": "audio/ho/sent_4.wav", "speaker_id": "SPK_HO_JH01", "domain": "Hygiene & Daily Life", "script": "Devanagari / Warang Chiti", "dialect": "Kolhan Ho", "source": "Kaggle Ho-Hindi FLN & Tribal Research Institute", "license": "CC-BY-4.0", "confidence": 0.96, "human_verified": true}
{"id": "JB-HIN-HO-0005", "source_language": "hi", "target_language": "ho", "source_text": "सूरज पूर्व दिशा में उगता है।", "target_text": "Singi do singi turu re rakap'a.", "audio": "audio/ho/sent_5.wav", "speaker_id": "SPK_HO_JH01", "domain": "EVS / Science", "script": "Devanagari / Warang Chiti", "dialect": "Kolhan Ho", "source": "Kaggle Ho-Hindi FLN & Tribal Research Institute", "license": "CC-BY-4.0", "confidence": 0.96, "human_verified": true}
{"id": "JB-HIN-HO-0006", "source_language": "hi", "target_language": "ho", "source_text": "सभी बच्चे शांत होकर ध्यान से सुनें।", "target_text": "Soben honko thir kete dhyan te ayumpe.", "audio": "audio/ho/sent_6.wav", "speaker_id": "SPK_HO_JH01", "domain": "Classroom Management", "script": "Devanagari / Warang Chiti", "dialect": "Kolhan Ho", "source": "Kaggle Ho-Hindi FLN & Tribal Research Institute", "license": "CC-BY-4.0", "confidence": 0.96, "human_verified": true}
{"id": "JB-HIN-HO-0007", "source_language": "hi", "target_language": "ho", "source_text": "पेड़ हमारे मित्र हैं, वे हमें छाया और फल देते हैं।", "target_text": "Daru do abu-ren gateko, inku abu umul ar jo emua.", "audio": "audio/ho/sent_7.wav", "speaker_id": "SPK_HO_JH01", "domain": "EVS", "script": "Devanagari / Warang Chiti", "dialect": "Kolhan Ho", "source": "Kaggle Ho-Hindi FLN & Tribal Research Institute", "license": "CC-BY-4.0", "confidence": 0.96, "human_verified": true}
{"id": "JB-HIN-HO-0008", "source_language": "hi", "target_language": "ho", "source_text": "इस चित्र में कितने पक्षी दिखाई दे रहे हैं?", "target_text": "Nena chitra re chinan chene nelotan?", "audio": "audio/ho/sent_8.wav", "speaker_id": "SPK_HO_JH01", "domain": "Assessment Prompt", "script": "Devanagari / Warang Chiti", "dialect": "Kolhan Ho", "source": "Kaggle Ho-Hindi FLN & Tribal Research Institute", "license": "CC-BY-4.0", "confidence": 0.96, "human_verified": true}
{"id": "JB-HIN-HO-0009", "source_language": "hi", "target_language": "ho", "source_text": "गाय हमें मीठा दूध देती है।", "target_text": "Gai abu sibin toa emua.", "audio": "audio/ho/sent_9.wav", "speaker_id": "SPK_HO_JH01", "domain": "FLN Reading", "script": "Devanagari / Warang Chiti", "dialect": "Kolhan Ho", "source": "Kaggle Ho-Hindi FLN & Tribal Research Institute", "license": "CC-BY-4.0", "confidence": 0.96, "human_verified": true}
{"id": "JB-HIN-HO-0010", "source_language": "hi", "target_language": "ho", "source_text": "कल सब लोग समय पर स्कूल आएँ।", "target_text": "Gapa sobenko okto re iskul hijupe.", "audio": "audio/ho/sent_10.wav", "speaker_id": "SPK_HO_JH01", "domain": "Classroom Instruction", "script": "Devanagari / Warang Chiti", "dialect": "Kolhan Ho", "source": "Kaggle Ho-Hindi FLN & Tribal Research Institute", "license": "CC-BY-4.0", "confidence": 0.96, "human_verified": true}
