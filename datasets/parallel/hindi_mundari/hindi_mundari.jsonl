{"id": "JB-HIN-MUN-0001", "source_language": "hi", "target_language": "mun", "source_text": "सुप्रभात बच्चों, अपनी किताब खोलो।", "target_text": "Setah Johar honko, apana pothi olo.", "audio": "audio/mun/sent_1.wav", "speaker_id": "SPK_MUN_RK02", "domain": "Classroom Instruction", "script": "Devanagari / Latin", "dialect": "Hasada Mundari", "source": "Karya Hindi-Mundari Translation & MunTTS", "license": "MIT", "confidence": 0.98, "human_verified": true}
{"id": "JB-HIN-MUN-0002", "source_language": "hi", "target_language": "mun", "source_text": "आज हम एक से दस तक गिनती सीखेंगे।", "target_text": "Tising abu miad' ate gel jaked lekha bu cheda.", "audio": "audio/mun/sent_2.wav", "speaker_id": "SPK_MUN_RK02", "domain": "FLN Mathematics", "script": "Devanagari / Latin", "dialect": "Hasada Mundari", "source": "Karya Hindi-Mundari Translation & MunTTS", "license": "MIT", "confidence": 0.98, "human_verified": true}
{"id": "JB-HIN-MUN-0003", "source_language": "hi", "target_language": "mun", "source_text": "दो और तीन मिलकर पाँच होते हैं।", "target_text": "Baria ar apia mesate monēa hobaoa.", "audio": "audio/mun/sent_3.wav", "speaker_id": "SPK_MUN_RK02", "domain": "FLN Mathematics", "script": "Devanagari / Latin", "dialect": "Hasada Mundari", "source": "Karya Hindi-Mundari Translation & MunTTS", "license": "MIT", "confidence": 0.98, "human_verified": true}
{"id": "JB-HIN-MUN-0004", "source_language": "hi", "target_language": "mun", "source_text": "हाथ धोकर खाना खाओ।", "target_text": "Ti arup' kete mandi jomepe.", "audio": "audio/mun/sent_4.wav", "speaker_id": "SPK_MUN_RK02", "domain": "Hygiene & Daily Life", "script": "Devanagari / Latin", "dialect": "Hasada Mundari", "source": "Karya Hindi-Mundari Translation & MunTTS", "license": "MIT", "confidence": 0.98, "human_verified": true}
{"id": "JB-HIN-MUN-0005", "source_language": "hi", "target_language": "mun", "source_text": "सूरज पूर्व दिशा में उगता है।", "target_text": "Singi do purub re rakap'a.", "audio": "audio/mun/sent_5.wav", "speaker_id": "SPK_MUN_RK02", "domain": "EVS / Science", "script": "Devanagari / Latin", "dialect": "Hasada Mundari", "source": "Karya Hindi-Mundari Translation & MunTTS", "license": "MIT", "confidence": 0.98, "human_verified": true}
{"id": "JB-HIN-MUN-0006", "source_language": "hi", "target_language": "mun", "source_text": "सभी बच्चे शांत होकर ध्यान से सुनें।", "target_text": "Soben honko thir kete dhyan te ayumepe.", "audio": "audio/mun/sent_6.wav", "speaker_id": "SPK_MUN_RK02", "domain": "Classroom Management", "script": "Devanagari / Latin", "dialect": "Hasada Mundari", "source": "Karya Hindi-Mundari Translation & MunTTS", "license": "MIT", "confidence": 0.98, "human_verified": true}
{"id": "JB-HIN-MUN-0007", "source_language": "hi", "target_language": "mun", "source_text": "पेड़ हमारे मित्र हैं, वे हमें छाया और फल देते हैं।", "target_text": "Daru do aburen gatiko, inku abu umul ar jo emua.", "audio": "audio/mun/sent_7.wav", "speaker_id": "SPK_MUN_RK02", "domain": "EVS", "script": "Devanagari / Latin", "dialect": "Hasada Mundari", "source": "Karya Hindi-Mundari Translation & MunTTS", "license": "MIT", "confidence": 0.98, "human_verified": true}
{"id": "JB-HIN-MUN-0008", "source_language": "hi", "target_language": "mun", "source_text": "इस चित्र में कितने पक्षी दिखाई दे रहे हैं?", "target_text": "Nea chitra re chimin chene nelotana?", "audio": "audio/mun/sent_8.wav", "speaker_id": "SPK_MUN_RK02", "domain": "Assessment Prompt", "script": "Devanagari / Latin", "dialect": "Hasada Mundari", "source": "Karya Hindi-Mundari Translation & MunTTS", "license": "MIT", "confidence": 0.98, "human_verified": true}
{"id": "JB-HIN-MUN-0009", "source_language": "hi", "target_language": "mun", "source_text": "गाय हमें मीठा दूध देती है।", "target_text": "Uri' abu sibin toa emua.", "audio": "audio/mun/sent_9.wav", "speaker_id": "SPK_MUN_RK02", "domain": "FLN Reading", "script": "Devanagari / Latin", "dialect": "Hasada Mundari", "source": "Karya Hindi-Mundari Translation & MunTTS", "license": "MIT", "confidence": 0.98, "human_verified": true}
{"id": "JB-HIN-MUN-0010", "source_language": "hi", "target_language": "mun", "source_text": "कल सब लोग समय पर स्कूल आएँ।", "target_text": "Gapa sobenko somoy re iskul hijupe.", "audio": "audio/mun/sent_10.wav", "speaker_id": "SPK_MUN_RK02", "domain": "Classroom Instruction", "script": "Devanagari / Latin", "dialect": "Hasada Mundari", "source": "Karya Hindi-Mundari Translation & MunTTS", "license": "MIT", "confidence": 0.98, "human_verified": true}
