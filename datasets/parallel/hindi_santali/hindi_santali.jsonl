{"id": "JB-HIN-SAT-0001", "source_language": "hi", "target_language": "sat", "source_text": "सुप्रभात बच्चों, अपनी किताब खोलो।", "target_text": "Bhor Johar gidirko, apnar pothi jhij me.", "audio": "audio/sat/sent_1.wav", "speaker_id": "SPK_SAT_DM03", "domain": "Classroom Instruction", "script": "Ol Chiki / Devanagari", "dialect": "Standard Santali", "source": "Bharatavani CIIL & Project VAANI", "license": "CC-BY-4.0", "confidence": 0.99, "human_verified": true}
{"id": "JB-HIN-SAT-0002", "source_language": "hi", "target_language": "sat", "source_text": "आज हम एक से दस तक गिनती सीखेंगे।", "target_text": "Teheñ abo mit' khon gel dhabic' lekha bo cheda.", "audio": "audio/sat/sent_2.wav", "speaker_id": "SPK_SAT_DM03", "domain": "FLN Mathematics", "script": "Ol Chiki / Devanagari", "dialect": "Standard Santali", "source": "Bharatavani CIIL & Project VAANI", "license": "CC-BY-4.0", "confidence": 0.99, "human_verified": true}
{"id": "JB-HIN-SAT-0003", "source_language": "hi", "target_language": "sat", "source_text": "दो और तीन मिलकर पाँच होते हैं।", "target_text": "Bar ar pe mesate mõrẽ hoyoa.", "audio": "audio/sat/sent_3.wav", "speaker_id": "SPK_SAT_DM03", "domain": "FLN Mathematics", "script": "Ol Chiki / Devanagari", "dialect": "Standard Santali", "source": "Bharatavani CIIL & Project VAANI", "license": "CC-BY-4.0", "confidence": 0.99, "human_verified": true}
{"id": "JB-HIN-SAT-0004", "source_language": "hi", "target_language": "sat", "source_text": "हाथ धोकर खाना खाओ।", "target_text": "Ti arup' kate daka jom me.", "audio": "audio/sat/sent_4.wav", "speaker_id": "SPK_SAT_DM03", "domain": "Hygiene & Daily Life", "script": "Ol Chiki / Devanagari", "dialect": "Standard Santali", "source": "Bharatavani CIIL & Project VAANI", "license": "CC-BY-4.0", "confidence": 0.99, "human_verified": true}
{"id": "JB-HIN-SAT-0005", "source_language": "hi", "target_language": "sat", "source_text": "सूरज पूर्व दिशा में उगता है।", "target_text": "Singi do samat' re rakap'aa.", "audio": "audio/sat/sent_5.wav", "speaker_id": "SPK_SAT_DM03", "domain": "EVS / Science", "script": "Ol Chiki / Devanagari", "dialect": "Standard Santali", "source": "Bharatavani CIIL & Project VAANI", "license": "CC-BY-4.0", "confidence": 0.99, "human_verified": true}
{"id": "JB-HIN-SAT-0006", "source_language": "hi", "target_language": "sat", "source_text": "सभी बच्चे शांत होकर ध्यान से सुनें।", "target_text": "Joto gidirko thir kate dhyan te añjom pe.", "audio": "audio/sat/sent_6.wav", "speaker_id": "SPK_SAT_DM03", "domain": "Classroom Management", "script": "Ol Chiki / Devanagari", "dialect": "Standard Santali", "source": "Bharatavani CIIL & Project VAANI", "license": "CC-BY-4.0", "confidence": 0.99, "human_verified": true}
{"id": "JB-HIN-SAT-0007", "source_language": "hi", "target_language": "sat", "source_text": "पेड़ हमारे मित्र हैं, वे हमें छाया और फल देते हैं।", "target_text": "Dare do abonren gate kana ko, unku do abon umul ar jo ko ema.", "audio": "audio/sat/sent_7.wav", "speaker_id": "SPK_SAT_DM03", "domain": "EVS", "script": "Ol Chiki / Devanagari", "dialect": "Standard Santali", "source": "Bharatavani CIIL & Project VAANI", "license": "CC-BY-4.0", "confidence": 0.99, "human_verified": true}
{"id": "JB-HIN-SAT-0008", "source_language": "hi", "target_language": "sat", "source_text": "इस चित्र में कितने पक्षी दिखाई दे रहे हैं?", "target_text": "Noa chitra re tina' chene nelok' kana?", "audio": "audio/sat/sent_8.wav", "speaker_id": "SPK_SAT_DM03", "domain": "Assessment Prompt", "script": "Ol Chiki / Devanagari", "dialect": "Standard Santali", "source": "Bharatavani CIIL & Project VAANI", "license": "CC-BY-4.0", "confidence": 0.99, "human_verified": true}
{"id": "JB-HIN-SAT-0009", "source_language": "hi", "target_language": "sat", "source_text": "गाय हमें मीठा दूध देती है।", "target_text": "Gai do aboa' sibin toa emaye.", "audio": "audio/sat/sent_9.wav", "speaker_id": "SPK_SAT_DM03", "domain": "FLN Reading", "script": "Ol Chiki / Devanagari", "dialect": "Standard Santali", "source": "Bharatavani CIIL & Project VAANI", "license": "CC-BY-4.0", "confidence": 0.99, "human_verified": true}
{"id": "JB-HIN-SAT-0010", "source_language": "hi", "target_language": "sat", "source_text": "कल सब लोग समय पर स्कूल आएँ।", "target_text": "Gapa joto hor somoy re iskul hijuk' pe.", "audio": "audio/sat/sent_10.wav", "speaker_id": "SPK_SAT_DM03", "domain": "Classroom Instruction", "script": "Ol Chiki / Devanagari", "dialect": "Standard Santali", "source": "Bharatavani CIIL & Project VAANI", "license": "CC-BY-4.0", "confidence": 0.99, "human_verified": true}
